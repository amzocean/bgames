[
  {
    "key": "81:1",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 1,
    "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ",
    "audioFile": "081-At-Takwir/081_001.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5801.mp3"
  },
  {
    "key": "81:2",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 2,
    "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
    "audioFile": "081-At-Takwir/081_002.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5802.mp3"
  },
  {
    "key": "81:3",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 3,
    "text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
    "audioFile": "081-At-Takwir/081_003.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5803.mp3"
  },
  {
    "key": "81:4",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 4,
    "text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
    "audioFile": "081-At-Takwir/081_004.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5804.mp3"
  },
  {
    "key": "81:5",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 5,
    "text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
    "audioFile": "081-At-Takwir/081_005.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5805.mp3"
  },
  {
    "key": "81:6",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 6,
    "text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
    "audioFile": "081-At-Takwir/081_006.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5806.mp3"
  },
  {
    "key": "81:7",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 7,
    "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
    "audioFile": "081-At-Takwir/081_007.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5807.mp3"
  },
  {
