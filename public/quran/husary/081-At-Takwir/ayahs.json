    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5816.mp3"
  },
  {
    "key": "81:17",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 17,
    "text": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
