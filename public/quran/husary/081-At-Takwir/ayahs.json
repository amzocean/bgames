    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5817.mp3"
  },
  {
    "key": "81:18",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 18,
    "text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
    "audioFile": "081-At-Takwir/081_018.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5818.mp3"
  },
  {
    "key": "81:19",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 19,
    "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ",
    "audioFile": "081-At-Takwir/081_019.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5819.mp3"
  },
  {
    "key": "81:20",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 20,
    "text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ",
    "audioFile": "081-At-Takwir/081_020.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5820.mp3"
  },
  {
    "key": "81:21",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 21,
    "text": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ",
    "audioFile": "081-At-Takwir/081_021.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5821.mp3"
  },
  {
    "key": "81:22",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 22,
    "text": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ",
    "audioFile": "081-At-Takwir/081_022.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5822.mp3"
  },
  {
    "key": "81:23",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 23,
    "text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
    "audioFile": "081-At-Takwir/081_023.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5823.mp3"
  },
  {
    "key": "81:24",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 24,
    "text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ",
    "audioFile": "081-At-Takwir/081_024.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5824.mp3"
  },
  {
    "key": "81:25",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 25,
    "text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ",
    "audioFile": "081-At-Takwir/081_025.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5825.mp3"
  },
  {
    "key": "81:26",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 26,
    "text": "فَأَيْنَ تَذْهَبُونَ",
    "audioFile": "081-At-Takwir/081_026.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5826.mp3"
  },
  {
    "key": "81:27",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 27,
    "text": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ",
    "audioFile": "081-At-Takwir/081_027.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5827.mp3"
  },
  {
    "key": "81:28",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 28,
    "text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
    "audioFile": "081-At-Takwir/081_028.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5828.mp3"
  },
  {
    "key": "81:29",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 29,
    "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ",
    "audioFile": "081-At-Takwir/081_029.mp3",
