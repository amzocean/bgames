    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 8,
    "text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
    "audioFile": "081-At-Takwir/081_008.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5808.mp3"
  },
  {
    "key": "81:9",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 9,
    "text": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ",
    "audioFile": "081-At-Takwir/081_009.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5809.mp3"
  },
  {
    "key": "81:10",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 10,
    "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
    "audioFile": "081-At-Takwir/081_010.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5810.mp3"
  },
  {
    "key": "81:11",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 11,
    "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
    "audioFile": "081-At-Takwir/081_011.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5811.mp3"
  },
  {
    "key": "81:12",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 12,
    "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
    "audioFile": "081-At-Takwir/081_012.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5812.mp3"
  },
  {
    "key": "81:13",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 13,
    "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
    "audioFile": "081-At-Takwir/081_013.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5813.mp3"
  },
  {
    "key": "81:14",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 14,
    "text": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ",
    "audioFile": "081-At-Takwir/081_014.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5814.mp3"
  },
  {
    "key": "81:15",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 15,
    "text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
    "audioFile": "081-At-Takwir/081_015.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5815.mp3"
  },
  {
    "key": "81:16",
    "surahNumber": 81,
    "surahName": "At-Takwir",
    "arabicSurahName": "سُورَةُ التَّكۡوِيرِ",
    "ayahNumber": 16,
    "text": "ٱلْجَوَارِ ٱلْكُنَّسِ",
