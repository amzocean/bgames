[
  {
    "key": "83:1",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 1,
    "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ",
    "audioFile": "083-Al-Mutaffifin/083_001.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5849.mp3"
  },
  {
    "key": "83:2",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 2,
    "text": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",
    "audioFile": "083-Al-Mutaffifin/083_002.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5850.mp3"
  },
  {
    "key": "83:3",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 3,
    "text": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
    "audioFile": "083-Al-Mutaffifin/083_003.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5851.mp3"
  },
  {
    "key": "83:4",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 4,
    "text": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ",
    "audioFile": "083-Al-Mutaffifin/083_004.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5852.mp3"
  },
  {
    "key": "83:5",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 5,
    "text": "لِيَوْمٍ عَظِيمٍۢ",
    "audioFile": "083-Al-Mutaffifin/083_005.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5853.mp3"
  },
  {
    "key": "83:6",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 6,
    "text": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ",
    "audioFile": "083-Al-Mutaffifin/083_006.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5854.mp3"
  },
  {
    "key": "83:7",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 7,
    "text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ",
    "audioFile": "083-Al-Mutaffifin/083_007.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5855.mp3"
  },
  {
    "key": "83:8",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 8,
    "text": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ",
    "audioFile": "083-Al-Mutaffifin/083_008.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5856.mp3"
  },
  {
    "key": "83:9",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 9,
    "text": "كِتَٰبٌۭ مَّرْقُومٌۭ",
    "audioFile": "083-Al-Mutaffifin/083_009.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5857.mp3"
  },
  {
    "key": "83:10",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 10,
    "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
    "audioFile": "083-Al-Mutaffifin/083_010.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5858.mp3"
  },
  {
    "key": "83:11",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 11,
    "text": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ",
    "audioFile": "083-Al-Mutaffifin/083_011.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5859.mp3"
  },
  {
    "key": "83:12",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 12,
    "text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ",
    "audioFile": "083-Al-Mutaffifin/083_012.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5860.mp3"
  },
  {
    "key": "83:13",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 13,
    "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ",
    "audioFile": "083-Al-Mutaffifin/083_013.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5861.mp3"
  },
  {
    "key": "83:14",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 14,
    "text": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ",
    "audioFile": "083-Al-Mutaffifin/083_014.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5862.mp3"
  },
  {
    "key": "83:15",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 15,
    "text": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ",
    "audioFile": "083-Al-Mutaffifin/083_015.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5863.mp3"
  },
  {
    "key": "83:16",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 16,
    "text": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ",
    "audioFile": "083-Al-Mutaffifin/083_016.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5864.mp3"
  },
  {
    "key": "83:17",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 17,
    "text": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
    "audioFile": "083-Al-Mutaffifin/083_017.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5865.mp3"
  },
  {
    "key": "83:18",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 18,
    "text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ",
    "audioFile": "083-Al-Mutaffifin/083_018.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5866.mp3"
  },
  {
    "key": "83:19",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 19,
    "text": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ",
    "audioFile": "083-Al-Mutaffifin/083_019.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5867.mp3"
  },
  {
    "key": "83:20",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 20,
    "text": "كِتَٰبٌۭ مَّرْقُومٌۭ",
    "audioFile": "083-Al-Mutaffifin/083_020.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5868.mp3"
  },
  {
    "key": "83:21",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 21,
    "text": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ",
    "audioFile": "083-Al-Mutaffifin/083_021.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5869.mp3"
  },
  {
    "key": "83:22",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 22,
    "text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
    "audioFile": "083-Al-Mutaffifin/083_022.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5870.mp3"
  },
  {
    "key": "83:23",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 23,
    "text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
    "audioFile": "083-Al-Mutaffifin/083_023.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5871.mp3"
  },
  {
    "key": "83:24",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 24,
    "text": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ",
    "audioFile": "083-Al-Mutaffifin/083_024.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5872.mp3"
  },
  {
    "key": "83:25",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 25,
    "text": "يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ",
    "audioFile": "083-Al-Mutaffifin/083_025.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5873.mp3"
  },
  {
    "key": "83:26",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 26,
    "text": "خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ",
    "audioFile": "083-Al-Mutaffifin/083_026.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5874.mp3"
  },
  {
    "key": "83:27",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 27,
    "text": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ",
    "audioFile": "083-Al-Mutaffifin/083_027.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5875.mp3"
  },
  {
    "key": "83:28",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 28,
    "text": "عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ",
    "audioFile": "083-Al-Mutaffifin/083_028.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5876.mp3"
  },
  {
    "key": "83:29",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 29,
    "text": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ",
    "audioFile": "083-Al-Mutaffifin/083_029.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5877.mp3"
  },
  {
    "key": "83:30",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 30,
    "text": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ",
    "audioFile": "083-Al-Mutaffifin/083_030.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5878.mp3"
  },
  {
    "key": "83:31",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 31,
    "text": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ",
    "audioFile": "083-Al-Mutaffifin/083_031.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5879.mp3"
  },
  {
    "key": "83:32",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 32,
    "text": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ",
    "audioFile": "083-Al-Mutaffifin/083_032.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5880.mp3"
  },
  {
    "key": "83:33",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 33,
    "text": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ",
    "audioFile": "083-Al-Mutaffifin/083_033.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5881.mp3"
  },
  {
    "key": "83:34",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 34,
    "text": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ",
    "audioFile": "083-Al-Mutaffifin/083_034.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5882.mp3"
  },
  {
    "key": "83:35",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 35,
    "text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
    "audioFile": "083-Al-Mutaffifin/083_035.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5883.mp3"
  },
  {
    "key": "83:36",
    "surahNumber": 83,
    "surahName": "Al-Mutaffifin",
    "arabicSurahName": "سُورَةُ المُطَفِّفِينَ",
    "ayahNumber": 36,
    "text": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ",
    "audioFile": "083-Al-Mutaffifin/083_036.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5884.mp3"
  }
]
