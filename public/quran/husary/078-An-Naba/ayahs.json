  },
  {
    "key": "78:6",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 6,
    "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا",
    "audioFile": "078-An-Naba/078_006.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5678.mp3"
  },
  {
    "key": "78:7",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 7,
    "text": "وَٱلْجِبَالَ أَوْتَادًۭا",
    "audioFile": "078-An-Naba/078_007.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5679.mp3"
  },
  {
    "key": "78:8",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 8,
    "text": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا",
    "audioFile": "078-An-Naba/078_008.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5680.mp3"
  },
  {
    "key": "78:9",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 9,
    "text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا",
    "audioFile": "078-An-Naba/078_009.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5681.mp3"
  },
  {
    "key": "78:10",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 10,
    "text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا",
    "audioFile": "078-An-Naba/078_010.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5682.mp3"
  },
  {
    "key": "78:11",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 11,
    "text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا",
    "audioFile": "078-An-Naba/078_011.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5683.mp3"
  },
  {
    "key": "78:12",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 12,
    "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا",
    "audioFile": "078-An-Naba/078_012.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5684.mp3"
  },
  {
    "key": "78:13",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 13,
    "text": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا",
    "audioFile": "078-An-Naba/078_013.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5685.mp3"
  },
  {
    "key": "78:14",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 14,
    "text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا",
    "audioFile": "078-An-Naba/078_014.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5686.mp3"
  },
  {
    "key": "78:15",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 15,
    "text": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا",
    "audioFile": "078-An-Naba/078_015.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5687.mp3"
  },
  {
    "key": "78:16",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 16,
    "text": "وَجَنَّٰتٍ أَلْفَافًا",
    "audioFile": "078-An-Naba/078_016.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5688.mp3"
  },
  {
    "key": "78:17",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 17,
    "text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا",
    "audioFile": "078-An-Naba/078_017.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5689.mp3"
  },
  {
    "key": "78:18",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 18,
    "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا",
    "audioFile": "078-An-Naba/078_018.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5690.mp3"
  },
  {
    "key": "78:19",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 19,
    "text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا",
    "audioFile": "078-An-Naba/078_019.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5691.mp3"
  },
  {
    "key": "78:20",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 20,
    "text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
    "audioFile": "078-An-Naba/078_020.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5692.mp3"
  },
  {
    "key": "78:21",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 21,
    "text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا",
    "audioFile": "078-An-Naba/078_021.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5693.mp3"
  },
  {
    "key": "78:22",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 22,
    "text": "لِّلطَّٰغِينَ مَـَٔابًۭا",
    "audioFile": "078-An-Naba/078_022.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5694.mp3"
  },
  {
    "key": "78:23",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 23,
    "text": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا",
    "audioFile": "078-An-Naba/078_023.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5695.mp3"
  },
  {
    "key": "78:24",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 24,
    "text": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا",
    "audioFile": "078-An-Naba/078_024.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5696.mp3"
  },
  {
    "key": "78:25",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 25,
    "text": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا",
    "audioFile": "078-An-Naba/078_025.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5697.mp3"
  },
  {
    "key": "78:26",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 26,
    "text": "جَزَآءًۭ وِفَاقًا",
    "audioFile": "078-An-Naba/078_026.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5698.mp3"
  },
  {
    "key": "78:27",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 27,
    "text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا",
    "audioFile": "078-An-Naba/078_027.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5699.mp3"
  },
  {
    "key": "78:28",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 28,
    "text": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا",
    "audioFile": "078-An-Naba/078_028.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5700.mp3"
  },
  {
    "key": "78:29",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 29,
    "text": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا",
    "audioFile": "078-An-Naba/078_029.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5701.mp3"
  },
  {
    "key": "78:30",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 30,
    "text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
    "audioFile": "078-An-Naba/078_030.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5702.mp3"
  },
  {
    "key": "78:31",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 31,
    "text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
    "audioFile": "078-An-Naba/078_031.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5703.mp3"
  },
  {
    "key": "78:32",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 32,
    "text": "حَدَآئِقَ وَأَعْنَٰبًۭا",
    "audioFile": "078-An-Naba/078_032.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5704.mp3"
  },
  {
    "key": "78:33",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 33,
    "text": "وَكَوَاعِبَ أَتْرَابًۭا",
    "audioFile": "078-An-Naba/078_033.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5705.mp3"
  },
  {
    "key": "78:34",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 34,
    "text": "وَكَأْسًۭا دِهَاقًۭا",
    "audioFile": "078-An-Naba/078_034.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5706.mp3"
  },
  {
    "key": "78:35",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 35,
    "text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا",
    "audioFile": "078-An-Naba/078_035.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5707.mp3"
  },
  {
    "key": "78:36",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 36,
    "text": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا",
    "audioFile": "078-An-Naba/078_036.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5708.mp3"
  },
  {
    "key": "78:37",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 37,
    "text": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا",
    "audioFile": "078-An-Naba/078_037.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5709.mp3"
  },
  {
    "key": "78:38",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 38,
    "text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا",
    "audioFile": "078-An-Naba/078_038.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5710.mp3"
  },
  {
    "key": "78:39",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 39,
    "text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
    "audioFile": "078-An-Naba/078_039.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5711.mp3"
  },
  {
    "key": "78:40",
    "surahNumber": 78,
    "surahName": "An-Naba",
    "arabicSurahName": "سُورَةُ النَّبَإِ",
    "ayahNumber": 40,
    "text": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
    "audioFile": "078-An-Naba/078_040.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5712.mp3"
  }
]
