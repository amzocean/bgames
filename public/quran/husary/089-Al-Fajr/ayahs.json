[
  {
    "key": "89:1",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 1,
    "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ",
    "audioFile": "089-Al-Fajr/089_001.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5994.mp3"
  },
  {
    "key": "89:2",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 2,
    "text": "وَلَيَالٍ عَشْرٍۢ",
    "audioFile": "089-Al-Fajr/089_002.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5995.mp3"
  },
  {
    "key": "89:3",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 3,
    "text": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
    "audioFile": "089-Al-Fajr/089_003.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5996.mp3"
  },
  {
    "key": "89:4",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 4,
    "text": "وَٱلَّيْلِ إِذَا يَسْرِ",
    "audioFile": "089-Al-Fajr/089_004.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5997.mp3"
  },
  {
    "key": "89:5",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 5,
    "text": "هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ",
    "audioFile": "089-Al-Fajr/089_005.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5998.mp3"
  },
  {
    "key": "89:6",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 6,
    "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
    "audioFile": "089-Al-Fajr/089_006.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5999.mp3"
  },
  {
    "key": "89:7",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 7,
    "text": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
    "audioFile": "089-Al-Fajr/089_007.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6000.mp3"
  },
  {
    "key": "89:8",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 8,
    "text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ",
    "audioFile": "089-Al-Fajr/089_008.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6001.mp3"
  },
  {
    "key": "89:9",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 9,
    "text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
    "audioFile": "089-Al-Fajr/089_009.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6002.mp3"
  },
  {
    "key": "89:10",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 10,
    "text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
    "audioFile": "089-Al-Fajr/089_010.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6003.mp3"
  },
  {
    "key": "89:11",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 11,
    "text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ",
    "audioFile": "089-Al-Fajr/089_011.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6004.mp3"
  },
  {
    "key": "89:12",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 12,
    "text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
    "audioFile": "089-Al-Fajr/089_012.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6005.mp3"
  },
  {
    "key": "89:13",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 13,
    "text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
    "audioFile": "089-Al-Fajr/089_013.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6006.mp3"
  },
  {
    "key": "89:14",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 14,
    "text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
    "audioFile": "089-Al-Fajr/089_014.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6007.mp3"
  },
  {
    "key": "89:15",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 15,
    "text": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
    "audioFile": "089-Al-Fajr/089_015.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6008.mp3"
  },
  {
    "key": "89:16",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 16,
    "text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ",
    "audioFile": "089-Al-Fajr/089_016.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6009.mp3"
  },
  {
    "key": "89:17",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 17,
    "text": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
    "audioFile": "089-Al-Fajr/089_017.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6010.mp3"
  },
  {
    "key": "89:18",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 18,
    "text": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
    "audioFile": "089-Al-Fajr/089_018.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6011.mp3"
  },
  {
    "key": "89:19",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 19,
    "text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا",
    "audioFile": "089-Al-Fajr/089_019.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6012.mp3"
  },
  {
    "key": "89:20",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 20,
    "text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا",
    "audioFile": "089-Al-Fajr/089_020.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6013.mp3"
  },
  {
    "key": "89:21",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 21,
    "text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا",
    "audioFile": "089-Al-Fajr/089_021.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6014.mp3"
  },
  {
    "key": "89:22",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 22,
    "text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا",
    "audioFile": "089-Al-Fajr/089_022.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6015.mp3"
  },
  {
    "key": "89:23",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 23,
    "text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
    "audioFile": "089-Al-Fajr/089_023.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6016.mp3"
  },
  {
    "key": "89:24",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 24,
    "text": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
    "audioFile": "089-Al-Fajr/089_024.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6017.mp3"
  },
  {
    "key": "89:25",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 25,
    "text": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ",
    "audioFile": "089-Al-Fajr/089_025.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6018.mp3"
  },
  {
    "key": "89:26",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 26,
    "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ",
    "audioFile": "089-Al-Fajr/089_026.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6019.mp3"
  },
  {
    "key": "89:27",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 27,
    "text": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
    "audioFile": "089-Al-Fajr/089_027.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6020.mp3"
  },
  {
    "key": "89:28",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 28,
    "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ",
    "audioFile": "089-Al-Fajr/089_028.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6021.mp3"
  },
  {
    "key": "89:29",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 29,
    "text": "فَٱدْخُلِى فِى عِبَٰدِى",
    "audioFile": "089-Al-Fajr/089_029.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6022.mp3"
  },
  {
    "key": "89:30",
    "surahNumber": 89,
    "surahName": "Al-Fajr",
    "arabicSurahName": "سُورَةُ الفَجۡرِ",
    "ayahNumber": 30,
    "text": "وَٱدْخُلِى جَنَّتِى",
    "audioFile": "089-Al-Fajr/089_030.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/6023.mp3"
  }
]
