    "surahName": "Al-Burooj",
    "arabicSurahName": "سُورَةُ البُرُوجِ",
    "ayahNumber": 6,
    "text": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ",
    "audioFile": "085-Al-Burooj/085_006.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5915.mp3"
  },
  {
    "key": "85:7",
    "surahNumber": 85,
    "surahName": "Al-Burooj",
    "arabicSurahName": "سُورَةُ البُرُوجِ",
    "ayahNumber": 7,
    "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ",
    "audioFile": "085-Al-Burooj/085_007.mp3",
