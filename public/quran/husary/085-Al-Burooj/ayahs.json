  },
  {
    "key": "85:8",
    "surahNumber": 85,
    "surahName": "Al-Burooj",
    "arabicSurahName": "سُورَةُ البُرُوجِ",
    "ayahNumber": 8,
    "text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
    "audioFile": "085-Al-Burooj/085_008.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5917.mp3"
  },
  {
    "key": "85:9",
    "surahNumber": 85,
    "surahName": "Al-Burooj",
    "arabicSurahName": "سُورَةُ البُرُوجِ",
    "ayahNumber": 9,
    "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ",
    "audioFile": "085-Al-Burooj/085_009.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5918.mp3"
  },
  {
    "key": "85:10",
    "surahNumber": 85,
    "surahName": "Al-Burooj",
    "arabicSurahName": "سُورَةُ البُرُوجِ",
    "ayahNumber": 10,
    "text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
    "audioFile": "085-Al-Burooj/085_010.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5919.mp3"
  },
  {
    "key": "85:11",
    "surahNumber": 85,
    "surahName": "Al-Burooj",
    "arabicSurahName": "سُورَةُ البُرُوجِ",
    "ayahNumber": 11,
    "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",
    "audioFile": "085-Al-Burooj/085_011.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5920.mp3"
  },
  {
    "key": "85:12",
    "surahNumber": 85,
    "surahName": "Al-Burooj",
    "arabicSurahName": "سُورَةُ البُرُوجِ",
    "ayahNumber": 12,
    "text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
    "audioFile": "085-Al-Burooj/085_012.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5921.mp3"
  },
  {
    "key": "85:13",
    "surahNumber": 85,
    "surahName": "Al-Burooj",
    "arabicSurahName": "سُورَةُ البُرُوجِ",
    "ayahNumber": 13,
    "text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
    "audioFile": "085-Al-Burooj/085_013.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5922.mp3"
  },
  {
