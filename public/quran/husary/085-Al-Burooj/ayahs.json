    "surahNumber": 85,
    "surahName": "Al-Burooj",
    "arabicSurahName": "سُورَةُ البُرُوجِ",
    "ayahNumber": 14,
    "text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
    "audioFile": "085-Al-Burooj/085_014.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5923.mp3"
  },
  {
