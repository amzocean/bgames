    "surahName": "Al-Infitar",
    "arabicSurahName": "سُورَةُ الانفِطَارِ",
    "ayahNumber": 8,
    "text": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ",
    "audioFile": "082-Al-Infitar/082_008.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5837.mp3"
  },
  {
