    "surahNumber": 82,
    "surahName": "Al-Infitar",
    "arabicSurahName": "سُورَةُ الانفِطَارِ",
    "ayahNumber": 7,
    "text": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
    "audioFile": "082-Al-Infitar/082_007.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5836.mp3"
