    "surahName": "Al-Infitar",
    "arabicSurahName": "سُورَةُ الانفِطَارِ",
    "ayahNumber": 3,
    "text": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
    "audioFile": "082-Al-Infitar/082_003.mp3",
