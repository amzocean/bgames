    "surahNumber": 82,
    "surahName": "Al-Infitar",
    "arabicSurahName": "سُورَةُ الانفِطَارِ",
    "ayahNumber": 9,
    "text": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
