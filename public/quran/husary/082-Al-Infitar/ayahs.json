    "surahName": "Al-Infitar",
    "arabicSurahName": "سُورَةُ الانفِطَارِ",
    "ayahNumber": 5,
    "text": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ",
