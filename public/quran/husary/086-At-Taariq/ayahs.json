[
  {
    "key": "86:1",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 1,
    "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ",
    "audioFile": "086-At-Taariq/086_001.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5932.mp3"
  },
  {
    "key": "86:2",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 2,
    "text": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
    "audioFile": "086-At-Taariq/086_002.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5933.mp3"
  },
  {
    "key": "86:3",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 3,
    "text": "ٱلنَّجْمُ ٱلثَّاقِبُ",
    "audioFile": "086-At-Taariq/086_003.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5934.mp3"
  },
  {
    "key": "86:4",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 4,
    "text": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ",
    "audioFile": "086-At-Taariq/086_004.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5935.mp3"
  },
  {
    "key": "86:5",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 5,
    "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ",
    "audioFile": "086-At-Taariq/086_005.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5936.mp3"
  },
  {
    "key": "86:6",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 6,
    "text": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ",
    "audioFile": "086-At-Taariq/086_006.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5937.mp3"
  },
  {
    "key": "86:7",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 7,
    "text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
    "audioFile": "086-At-Taariq/086_007.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5938.mp3"
  },
  {
    "key": "86:8",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 8,
    "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ",
    "audioFile": "086-At-Taariq/086_008.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5939.mp3"
  },
  {
    "key": "86:9",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 9,
    "text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
    "audioFile": "086-At-Taariq/086_009.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5940.mp3"
  },
  {
    "key": "86:10",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 10,
    "text": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ",
    "audioFile": "086-At-Taariq/086_010.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5941.mp3"
  },
  {
    "key": "86:11",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 11,
    "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
    "audioFile": "086-At-Taariq/086_011.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5942.mp3"
  },
  {
    "key": "86:12",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 12,
    "text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
    "audioFile": "086-At-Taariq/086_012.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5943.mp3"
  },
  {
    "key": "86:13",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 13,
    "text": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ",
    "audioFile": "086-At-Taariq/086_013.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5944.mp3"
  },
  {
    "key": "86:14",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 14,
    "text": "وَمَا هُوَ بِٱلْهَزْلِ",
    "audioFile": "086-At-Taariq/086_014.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5945.mp3"
  },
  {
    "key": "86:15",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 15,
    "text": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا",
    "audioFile": "086-At-Taariq/086_015.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5946.mp3"
  },
  {
    "key": "86:16",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 16,
    "text": "وَأَكِيدُ كَيْدًۭا",
    "audioFile": "086-At-Taariq/086_016.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5947.mp3"
  },
  {
    "key": "86:17",
    "surahNumber": 86,
    "surahName": "At-Taariq",
    "arabicSurahName": "سُورَةُ الطَّارِقِ",
    "ayahNumber": 17,
    "text": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
    "audioFile": "086-At-Taariq/086_017.mp3",
