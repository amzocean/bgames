    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 3,
    "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
    "audioFile": "084-Al-Inshiqaaq/084_003.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5887.mp3"
  },
