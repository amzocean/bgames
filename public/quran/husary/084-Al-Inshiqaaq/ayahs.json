    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 4,
    "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
    "audioFile": "084-Al-Inshiqaaq/084_004.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5888.mp3"
  },
  {
    "key": "84:5",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 5,
    "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
    "audioFile": "084-Al-Inshiqaaq/084_005.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5889.mp3"
  },
  {
    "key": "84:6",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 6,
    "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ",
    "audioFile": "084-Al-Inshiqaaq/084_006.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5890.mp3"
  },
  {
    "key": "84:7",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 7,
    "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
    "audioFile": "084-Al-Inshiqaaq/084_007.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5891.mp3"
  },
  {
    "key": "84:8",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 8,
    "text": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا",
    "audioFile": "084-Al-Inshiqaaq/084_008.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5892.mp3"
  },
  {
    "key": "84:9",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 9,
    "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا",
    "audioFile": "084-Al-Inshiqaaq/084_009.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5893.mp3"
  },
  {
    "key": "84:10",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 10,
    "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
    "audioFile": "084-Al-Inshiqaaq/084_010.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5894.mp3"
  },
  {
    "key": "84:11",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 11,
    "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا",
    "audioFile": "084-Al-Inshiqaaq/084_011.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5895.mp3"
  },
  {
    "key": "84:12",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 12,
    "text": "وَيَصْلَىٰ سَعِيرًا",
    "audioFile": "084-Al-Inshiqaaq/084_012.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5896.mp3"
  },
  {
    "key": "84:13",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 13,
    "text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
    "audioFile": "084-Al-Inshiqaaq/084_013.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5897.mp3"
  },
  {
    "key": "84:14",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 14,
    "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
    "audioFile": "084-Al-Inshiqaaq/084_014.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5898.mp3"
  },
  {
    "key": "84:15",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 15,
    "text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا",
    "audioFile": "084-Al-Inshiqaaq/084_015.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5899.mp3"
  },
  {
    "key": "84:16",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 16,
    "text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
    "audioFile": "084-Al-Inshiqaaq/084_016.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5900.mp3"
  },
  {
    "key": "84:17",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 17,
    "text": "وَٱلَّيْلِ وَمَا وَسَقَ",
    "audioFile": "084-Al-Inshiqaaq/084_017.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5901.mp3"
  },
  {
    "key": "84:18",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 18,
    "text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
    "audioFile": "084-Al-Inshiqaaq/084_018.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5902.mp3"
  },
  {
    "key": "84:19",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 19,
    "text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ",
    "audioFile": "084-Al-Inshiqaaq/084_019.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5903.mp3"
  },
  {
    "key": "84:20",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 20,
    "text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
    "audioFile": "084-Al-Inshiqaaq/084_020.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5904.mp3"
  },
  {
    "key": "84:21",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 21,
    "text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
    "audioFile": "084-Al-Inshiqaaq/084_021.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5905.mp3"
  },
  {
    "key": "84:22",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 22,
    "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
    "audioFile": "084-Al-Inshiqaaq/084_022.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5906.mp3"
  },
  {
    "key": "84:23",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 23,
    "text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
    "audioFile": "084-Al-Inshiqaaq/084_023.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5907.mp3"
  },
  {
    "key": "84:24",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 24,
    "text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
    "audioFile": "084-Al-Inshiqaaq/084_024.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5908.mp3"
  },
  {
    "key": "84:25",
    "surahNumber": 84,
    "surahName": "Al-Inshiqaaq",
    "arabicSurahName": "سُورَةُ الانشِقَاقِ",
    "ayahNumber": 25,
    "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
    "audioFile": "084-Al-Inshiqaaq/084_025.mp3",
