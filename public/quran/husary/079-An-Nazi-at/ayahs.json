[
  {
    "key": "79:1",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 1,
    "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا",
    "audioFile": "079-An-Nazi-at/079_001.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5713.mp3"
  },
  {
    "key": "79:2",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 2,
    "text": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا",
    "audioFile": "079-An-Nazi-at/079_002.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5714.mp3"
  },
  {
    "key": "79:3",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 3,
    "text": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا",
    "audioFile": "079-An-Nazi-at/079_003.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5715.mp3"
  },
  {
    "key": "79:4",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 4,
    "text": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا",
    "audioFile": "079-An-Nazi-at/079_004.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5716.mp3"
  },
  {
    "key": "79:5",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 5,
    "text": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا",
    "audioFile": "079-An-Nazi-at/079_005.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5717.mp3"
  },
  {
    "key": "79:6",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 6,
    "text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
    "audioFile": "079-An-Nazi-at/079_006.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5718.mp3"
  },
  {
    "key": "79:7",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 7,
    "text": "تَتْبَعُهَا ٱلرَّادِفَةُ",
    "audioFile": "079-An-Nazi-at/079_007.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5719.mp3"
  },
  {
    "key": "79:8",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 8,
    "text": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ",
    "audioFile": "079-An-Nazi-at/079_008.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5720.mp3"
  },
  {
    "key": "79:9",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 9,
    "text": "أَبْصَٰرُهَا خَٰشِعَةٌۭ",
    "audioFile": "079-An-Nazi-at/079_009.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5721.mp3"
  },
  {
    "key": "79:10",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 10,
    "text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
    "audioFile": "079-An-Nazi-at/079_010.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5722.mp3"
  },
  {
    "key": "79:11",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 11,
    "text": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ",
    "audioFile": "079-An-Nazi-at/079_011.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5723.mp3"
  },
  {
    "key": "79:12",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 12,
    "text": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ",
    "audioFile": "079-An-Nazi-at/079_012.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5724.mp3"
  },
  {
    "key": "79:13",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 13,
    "text": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ",
    "audioFile": "079-An-Nazi-at/079_013.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5725.mp3"
  },
  {
    "key": "79:14",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 14,
    "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
    "audioFile": "079-An-Nazi-at/079_014.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5726.mp3"
  },
  {
    "key": "79:15",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 15,
    "text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
    "audioFile": "079-An-Nazi-at/079_015.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5727.mp3"
  },
  {
    "key": "79:16",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 16,
    "text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
    "audioFile": "079-An-Nazi-at/079_016.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5728.mp3"
  },
  {
    "key": "79:17",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 17,
    "text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
    "audioFile": "079-An-Nazi-at/079_017.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5729.mp3"
  },
  {
    "key": "79:18",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 18,
    "text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
    "audioFile": "079-An-Nazi-at/079_018.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5730.mp3"
  },
  {
    "key": "79:19",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 19,
    "text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
    "audioFile": "079-An-Nazi-at/079_019.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5731.mp3"
  },
  {
    "key": "79:20",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 20,
    "text": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ",
    "audioFile": "079-An-Nazi-at/079_020.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5732.mp3"
  },
  {
    "key": "79:21",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 21,
    "text": "فَكَذَّبَ وَعَصَىٰ",
    "audioFile": "079-An-Nazi-at/079_021.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5733.mp3"
  },
  {
    "key": "79:22",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 22,
    "text": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
    "audioFile": "079-An-Nazi-at/079_022.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5734.mp3"
  },
  {
    "key": "79:23",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 23,
    "text": "فَحَشَرَ فَنَادَىٰ",
    "audioFile": "079-An-Nazi-at/079_023.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5735.mp3"
  },
  {
    "key": "79:24",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 24,
    "text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
    "audioFile": "079-An-Nazi-at/079_024.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5736.mp3"
  },
  {
    "key": "79:25",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 25,
    "text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ",
    "audioFile": "079-An-Nazi-at/079_025.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5737.mp3"
  },
  {
    "key": "79:26",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 26,
    "text": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ",
    "audioFile": "079-An-Nazi-at/079_026.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5738.mp3"
  },
  {
    "key": "79:27",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 27,
    "text": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
    "audioFile": "079-An-Nazi-at/079_027.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5739.mp3"
  },
  {
    "key": "79:28",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 28,
    "text": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
    "audioFile": "079-An-Nazi-at/079_028.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5740.mp3"
  },
  {
    "key": "79:29",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 29,
    "text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
    "audioFile": "079-An-Nazi-at/079_029.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5741.mp3"
  },
  {
    "key": "79:30",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 30,
    "text": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
    "audioFile": "079-An-Nazi-at/079_030.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5742.mp3"
  },
  {
    "key": "79:31",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 31,
    "text": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
    "audioFile": "079-An-Nazi-at/079_031.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5743.mp3"
  },
  {
    "key": "79:32",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 32,
    "text": "وَٱلْجِبَالَ أَرْسَىٰهَا",
    "audioFile": "079-An-Nazi-at/079_032.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5744.mp3"
  },
  {
    "key": "79:33",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 33,
    "text": "مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
    "audioFile": "079-An-Nazi-at/079_033.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5745.mp3"
  },
  {
    "key": "79:34",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 34,
    "text": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
    "audioFile": "079-An-Nazi-at/079_034.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5746.mp3"
  },
  {
    "key": "79:35",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 35,
    "text": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ",
    "audioFile": "079-An-Nazi-at/079_035.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5747.mp3"
  },
  {
    "key": "79:36",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 36,
    "text": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
    "audioFile": "079-An-Nazi-at/079_036.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5748.mp3"
  },
  {
    "key": "79:37",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 37,
    "text": "فَأَمَّا مَن طَغَىٰ",
    "audioFile": "079-An-Nazi-at/079_037.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5749.mp3"
  },
  {
    "key": "79:38",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 38,
    "text": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
    "audioFile": "079-An-Nazi-at/079_038.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5750.mp3"
  },
  {
    "key": "79:39",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 39,
    "text": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
    "audioFile": "079-An-Nazi-at/079_039.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5751.mp3"
  },
  {
    "key": "79:40",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 40,
    "text": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
    "audioFile": "079-An-Nazi-at/079_040.mp3",
    "sourceUrl": "https://cdn.islamic.network/quran/audio/128/ar.husary/5752.mp3"
  },
  {
    "key": "79:41",
    "surahNumber": 79,
    "surahName": "An-Nazi'at",
    "arabicSurahName": "سُورَةُ النَّازِعَاتِ",
    "ayahNumber": 41,
