    "surahName": "Al-Ghaashiya",
    "arabicSurahName": "سُورَةُ الغَاشِيَةِ",
    "ayahNumber": 7,
    "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ",
