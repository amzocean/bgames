    "surahName": "Al-Ghaashiya",
    "arabicSurahName": "سُورَةُ الغَاشِيَةِ",
    "ayahNumber": 6,
    "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ",
    "audioFile": "088-Al-Ghaashiya/088_006.mp3",
